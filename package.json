{
  "name": "memory-forge-rpg",
  "version": "0.8.1-aio.2",
  "private": true,
  "description": "Full Memory Forge v0.8.1 handoff; subscription-only Codex-led Claude CLI instructions; gameplay and design preserved",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:data": "node content/build.mjs data",
    "build:proto": "node tools/build_prototype.mjs",
    "vectors": "node tools/gen_vectors.mjs",
    "test": "node --test engine/tests/*.test.mjs",
    "fuzz": "node engine/tests/fuzz_runs.mjs 100 short && node engine/tests/fuzz_runs.mjs 40 full",
    "balance": "node engine/tests/balance_probe.mjs 300",
    "balance:late": "node engine/tests/balance_probe.mjs 350 --late",
    "smoke": "node prototype/tests/smoke.mjs 2",
    "docs": "python3 tools/ai/build_delivery_pdf.py --rebuild-base",
    "check": "python3 tools/ai/check_local.py",
    "audit:economy": "python3 tools/review/economy_audit.py",
    "test:proposals": "node --test proposals/tests/*.test.cjs",
    "test:memory-ui": "node --test prototype/tests/memory_v2.mjs",
    "test:late-ui": "node --test prototype/tests/late_enemy_actions.mjs",
    "docs:source": "python3 tools/build_integrated_design.py",
    "test:docs": "python3 tools/check_integrated_release.py && python3 tools/audit/test_document_contract.py",
    "docs:legacy": "node tools/gen_docs.mjs && node tools/build_docs.mjs",
    "verify:manifest": "python3 tools/ai/verify_manifest.py",
    "docs:game": "python3 tools/build_integrated_design.py --pdf",
    "manifest:release": "python3 tools/ai/build_manifest.py",
    "test:handoff": "python3 tools/ai/test_handoff.py",
    "check:legacy": "tools/run_all_checks.sh"
  },
  "devDependencies": {
    "marked": "^15.0.0",
    "playwright": "^1.56.0"
  }
}
