  "scenes": [
    {
      "id": "aila_lobby_01",
      "kind": "lobby",
      "title": "차보다 먼저 고른 자리",
      "trigger": {
        "on": "tap",
        "note": "로비의 캐릭터 선택 후 명시적 반응 재생. 반복 탭으로 신체를 평가하는 분기 없음."
      },
      "why": "업무를 핑계로 쉬게 해 주는 대신 자신이 같이 있고 싶어서 상대를 불러 세운다.",
      "intent": "시작: 장부를 덮고 측후면에서 종을 고른다. 핵심: 종 한 번→옆자리로 찻잔→눈맞춤. 끝: 의자 등받이에 손을 얹은 초대 자세. 등 노출 로브와 옆트임은 원형 유지, 시선의 종착점은 얼굴. 의상 확인용 측후면은 짧게, 카메라는 얼굴·손·찻잔의 관계를 읽는다.",
      "assets": [
        {
          "key": "bg",
          "type": "image",
          "status": "ready"
        },
        {
          "key": "fig_action1",
          "type": "image",
          "status": "ready"
        },
        {
          "key": "fig_action2",
