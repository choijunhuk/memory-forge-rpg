  "scenes": [
    {
      "id": "harin_lobby_01",
      "kind": "lobby",
      "title": "확인해도 되는 주머니",
      "trigger": {
        "on": "tap",
        "note": "로비 캐릭터 탭. 반복 입력은 현재 대사 완성/다음 박자만 진행하며 새 장면을 겹쳐 시작하지 않는다."
      },
      "why": "작은 인형을 숨기는 익숙한 습관을 스스로 되돌려, 공방장에게는 취향과 빈 시간을 보여 주고 싶다는 뜻을 행동으로 남긴다.",
      "intent": "26세 하린의 강인한 전위 실루엣과 무뚝뚝한 반말, 칭찬과 사적인 초대 앞에서만 망설이는 배려를 보존한다. 180cm 탄탄한 체형·짧은 남색 머리·회청색 눈·왼쪽 눈썹 위 흉터·어깨와 허리선이 드러나는 서리빛 경량 갑주·한쪽 긴 망토·하이웨이스트 전투 바지·대형 방패를 바꾸지 않는다. 귀여운 취향은 유아화 장치가 아니며 상사처럼 명령하거나 일방적인 보호로 관계를 끝내지 않는다. 얼굴·손·방패를 연결하고 노출 부위만 잘라 보여 주지 않는다.",
      "assets": [
        {
          "key": "bg_room",
          "type": "image",
          "status": "ready"
        },
        {
          "key": "fig_cough",
          "type": "image",
