  "sourceModesSha256": "e13f2d1f2bcbe8cd2247bfd1ded287b4eecd5c76bb326662bfe3489536f30c30",
  "sourceModesJson": "{\n  \"schemaVersion\": 1,\n  \"source\": \"docs/source_v0.8.1/11_chapter.md §11.1·§11.4–§11.7·§11.9·§11.11·§11.13, 13_chapter.md §13.3\",\n  \"note\": \"Supplements data/game_data.json → progression (unchanged). Only rules and numbers written in the source; anything the source leaves open is DECISION_PENDING and the engine throws CONTENT_NOT_AUTHORED instead of inventing it.\",\n  \"resets\": {\n    \"source\": \"§13.3 일일 초기화 05:00 KST, 주간 초기화 월요일 05:00 KST\",\n    \"utcOffsetMinutes\": 540,\n    \"dailyHour\": 5,\n    \"weeklyWeekday\": 1,\n    \"weeklyHour\": 5\n  },\n  \"dungeon\": {\n    \"stars\": { \"source\": \"§11.5 별 3개 = 승리 + 4턴 이내 + 체력 50% 이상\", \"maxTurns\": 4, \"minHpPct\": 50 },\n    \"waves\": {\n      \"source\": \"§11.5 저장 덱으로 단일 전투(1~3웨이브)\",\n      \"minWaves\": 1,\n      \"maxWaves\": 3,\n      \"status\": \"DECISION_PENDING\",\n      \"reason\": \"No enemy composition per dungeon and tier exists in the source or data.\",\n      \"encounters\": null\n    },\n    \"defeatStamina\": {\n      \"status\": \"DECISION_PENDING\",\n      \"reason\": \"§11.4/§11.5 give 20 집중 per run and per sweep but do not say whether a lost battle spends it. A victory settles and spends 20; a defeat cannot settle (CONTENT_NOT_AUTHORED) until this is authored.\"\n    },\n    \"tierGate\": {\n      \"status\": \"NO_RULE_IN_SOURCE\",\n      \"reading\": \"§11.5 gates each dungeon by account level only and names no per-tier gate, so none is added; every tier of an unlocked dungeon is open and harder tiers are limited by stage-level scaling (§11.1).\"\n    }\n  },\n  \"weeklyBoss\": {\n    \"source\": \"§11.6 구역 보스 3종(종을 삼킨 기록관·거울의 공증인·잠든 정원) + 기록소의 대사서\",\n    \"bosses\": [\"b_bell\", \"b_notary\", \"b_garden\", \"b_archivist\"]\n  },\n  \"rift\": {\n    \"battles\": { \"source\": \"§11.7 층마다 3연전: 1전·3전은 1파티, 2전은 2파티\", \"twoTeamOrder\": [0, 1, 0], \"oneTeamOrder\": [0, 0, 0] },\n    \"distinctCharacters\": 6,\n    \"smallRosterMaxStars\": 2,\n    \"starPortionsPct\": [60, 20, 20],\n    \"cycleStartHour\": 11,\n    \"cycleStartHourSource\": \"§13.3 기록 균열: 시즌 1일·15일·29일 11:00 시작(14일 주기)\",\n    \"teamsByFloor\": {\n      \"source\": \"§11.7 (v0.8.1 active text) and §11.13 / data/design_policy_v0.8.json rift target\",\n      \"v0.8.1\": [2, 2, 2, 2, 2, 2],\n      \"target\": [1, 1, 1, 2, 2, 2]\n    },\n    \"activeTeamPolicy\": \"v0.8.1\",\n    \"stars\": {\n      \"source\": \"§11.7 별 3개 기준: 3전 모두 승리 / 총 턴 수 / 남은 체력\",\n      \"status\": \"DECISION_PENDING\",\n      \"reason\": \"The source names the total-turn and remaining-HP criteria without thresholds; a cleared floor cannot be scored or settled (CONTENT_NOT_AUTHORED) until both exist.\",\n      \"maxTotalTurns\": null,\n      \"minHpPct\": null\n    },\n    \"rotation\": {\n      \"source\": \"§11.7 14일마다 층별 규칙(표)과 적 조합이 바뀐다\",\n      \"status\": \"DECISION_PENDING\",\n      \"reason\": \"No per-cycle assignment of the six rules to floors and no enemy lineups exist in the source or data.\",\n      \"cycles\": null\n    },\n    \"floorOrder\": {\n      \"status\": \"NO_RULE_IN_SOURCE\",\n      \"reading\": \"§11.7 gives the floors, their levels and rewards but no requirement to clear floor n-1 first, so floors are not gated on each other.\"\n    },\n    \"modifiers\": {\n      \"source\": \"§11.1 기록 균열 규칙 표\",\n      \"rift_reserve\": { \"reservedBps\": 3000, \"immediateBps\": -1000 },\n      \"rift_break\": { \"gaugeBps\": 15000, \"brokenDamageBps\": 5000 },\n      \"rift_ink\": { \"smudgePerTurn\": 1, \"perExhaustBps\": 300 },\n      \"rift_debt\": { \"debtCapAdd\": 2, \"debtDamageBps\": 1500 },\n      \"rift_bloom\": { \"growthCapAdd\": 2, \"growthBlock\": 3 },\n      \"rift_echo\": { \"echoMaxAdd\": 2, \"distinctChain\": 3, \"apGain\": 1 }\n    }\n  },\n  \"daily\": {\n    \"source\": \"§11.1 계정 레벨 5 일일 임무, §11.11 일일 100점(5개 × 20), §11.13 선택형 100점 목표\",\n    \"unlock\": 5,\n    \"pointsCap\": 100,\n    \"goals\": {\n      \"d_login\": { \"event\": \"login\", \"n\": 1 },\n      \"d_stamina\": { \"event\": \"staminaSpent\", \"n\": 120 },\n      \"d_battle\": { \"event\": \"battleWin\", \"n\": 3 },\n      \"d_level\": { \"event\": \"levelUp\", \"n\": 1 },\n      \"d_affinity\": { \"event\": \"affinity\", \"n\": 1 }\n    },\n    \"activePolicy\": \"v0.8.1\",\n    \"targetPool\": {\n      \"source\": \"§11.13 콘텐츠 완료·집중 정산·교류 등 대체 행동으로 달성\",\n      \"status\": \"DECISION_PENDING\",\n      \"reason\": \"The selectable task list, its events, goals and points are not authored.\",\n      \"tasks\": null\n    }\n  }\n}\n",
