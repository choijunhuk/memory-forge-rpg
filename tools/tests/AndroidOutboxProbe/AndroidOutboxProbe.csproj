<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DefineConstants>$(DefineConstants);UNITY_ANDROID</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NewtonsoftPath Condition="'$(NewtonsoftPath)' == ''">$(MSBuildSDKsPath)/../Newtonsoft.Json.dll</NewtonsoftPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../client/MemoryForgeUnity/Assets/Scripts/Practice*.cs" />
    <Compile Include="../../../client/MemoryForgeUnity/Assets/Scripts/RecruitmentPublicSnapshot.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
  </ItemGroup>
</Project>
